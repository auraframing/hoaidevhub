--==================================================
-- FAKE LAG (LOCAL VISUAL ONLY)
--==================================================

-- This is only a client-side visual delay for OTHER players.
-- LocalPlayer is explicitly excluded. It does not change real ping
-- and it does not send fake network data to the server.

local FakeLagBuffer = {}
local FakeLagClock = 0

local function ClearFakeLagBuffer()
	table.clear(FakeLagBuffer)
end

local function SampleFakeLag()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")

			if root and root:IsA("BasePart") then
				local queue = FakeLagBuffer[player]

				if not queue then
					queue = {}
					FakeLagBuffer[player] = queue
				end

				queue[#queue + 1] = {
					time = os.clock(),
					pivot = character:GetPivot(),
				}

				while #queue > 8 do
					table.remove(queue, 1)
				end
			end
		end
	end
end

local function ApplyFakeLag()
	local now = os.clock()

	for player, queue in pairs(FakeLagBuffer) do
		if player ~= LP and player.Parent and #queue > 0 then
			local chosen

			for i = 1, #queue do
				local snapshot = queue[i]
				if now - snapshot.time >= Settings.FakeLagDelay then
					chosen = snapshot
				else
					break
				end
			end

			if chosen then
				local character = player.Character
				if character and character.Parent then
					pcall(function()
						character:PivotTo(chosen.pivot)
					end)
				end
			end
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	FakeLagBuffer[player] = nil
end)

RunService.RenderStepped:Connect(function(deltaTime)
	if not Settings.FakeLag then
		return
	end

	FakeLagClock += deltaTime

	if FakeLagClock >= Settings.FakeLagInterval then
		FakeLagClock = 0
		SampleFakeLag()
	end

	ApplyFakeLag()
end)

