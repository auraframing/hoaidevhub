local FlyVelocity
local FlyGyro

local FlyUp = false
local FlyDown = false

local function StopFly()
	if FlyVelocity then
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyGyro then
		FlyGyro:Destroy()
		FlyGyro = nil
	end

	local character = LP.Character
	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.AutoRotate = true
	end
end

local function StartFly()
	local character = LP.Character
	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not root or not humanoid then
		return
	end

	StopFly()

	humanoid.AutoRotate = false

	FlyVelocity =
		Instance.new("BodyVelocity")

	FlyVelocity.Name =
		"HoaiFlyVelocity"

	FlyVelocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	FlyVelocity.P = 5000
	FlyVelocity.Velocity = Vector3.zero
	FlyVelocity.Parent = root

	FlyGyro =
		Instance.new("BodyGyro")

	FlyGyro.Name =
		"HoaiFlyGyro"

	FlyGyro.MaxTorque =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	FlyGyro.P = 50000
	FlyGyro.D = 500
	FlyGyro.CFrame = root.CFrame
	FlyGyro.Parent = root
end

