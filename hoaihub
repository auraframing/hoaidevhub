RunService.Heartbeat:Connect(
	function()

		if Settings.SpeedEnabled
			or Settings.JumpEnabled then

			ApplyMovement()
		end

		if Settings.NoClip then
			SetNoClip(true)
		end

		if Settings.FlyEnabled
			and FlyVelocity
			and FlyGyro then

			local character =
				LP.Character

			if not character then
				return
			end

			local root =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if not root
				or not humanoid then
				return
			end

			Camera =
				workspace.CurrentCamera

			local moveDirection =
				humanoid.MoveDirection

			local direction =
				moveDirection

			if Settings.FlyCamera
				and Camera then

				local forward =
					Camera.CFrame.LookVector

				local right =
					Camera.CFrame.RightVector

				direction =
					right * moveDirection.X
					+ forward * moveDirection.Z

				if direction.Magnitude > 1 then
					direction =
						direction.Unit
				end
			end

			local vertical =
				0

			if FlyUp then
				vertical += 1
			end

			if FlyDown then
				vertical -= 1
			end

			FlyVelocity.Velocity =
				direction
				* Settings.FlySpeed
				+ Vector3.new(
					0,
					vertical
						* Settings.FlySpeed,
					0
				)

			if Settings.FlyCamera
				and Camera then

				FlyGyro.CFrame =
					CFrame.lookAt(
						root.Position,
						root.Position
							+ Camera.CFrame.LookVector
					)

			elseif direction.Magnitude > 0.05 then

				FlyGyro.CFrame =
					CFrame.lookAt(
						root.Position,
						root.Position + direction
					)
			end
		end
	end
)

