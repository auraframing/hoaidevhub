RunService:BindToRenderStep(
	"HoaiDevHubAim",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		Camera =
			workspace.CurrentCamera

		if not Camera then
			return
		end

		AimFOV.Size =
			UDim2.fromOffset(
				Settings.AimFOV * 2,
				Settings.AimFOV * 2
			)

		AimFOV.Visible =
			Settings.AimBot

		if not Settings.AimBot then

			CurrentTarget = nil
			AimLine.Visible = false

			return
		end

		local now =
			os.clock()

		if now - LastAimUpdate <
			Settings.AimUpdateInterval then

			return
		end

		LastAimUpdate =
			now

		CurrentTarget =
			GetAimTarget()

		if not CurrentTarget then

			AimLine.Visible =
				false

			return
		end

		local head =
			CurrentTarget:FindFirstChild(
				"Head"
			)
			or CurrentTarget:FindFirstChild(
				"HumanoidRootPart"
			)

		if not head then

			CurrentTarget =
				nil

			AimLine.Visible =
				false

			return
		end

		local position, visible =
			Camera:WorldToViewportPoint(
				head.Position
			)

		if not visible
			or position.Z <= 0 then

			CurrentTarget =
				nil

			AimLine.Visible =
				false

			return
		end

		local center =
			Vector2.new(
				Camera.ViewportSize.X / 2,
				Camera.ViewportSize.Y / 2
			)

		local targetPosition =
			Vector2.new(
				position.X,
				position.Y
			)

		local delta =
			targetPosition
			- center

		local screenDistance =
			delta.Magnitude

		if screenDistance > 0 then

			AimLine.Visible =
				true

			AimLine.Position =
				UDim2.fromOffset(
					center.X,
					center.Y
				)

			AimLine.Size =
				UDim2.fromOffset(
					screenDistance,
					2
				)

			AimLine.Rotation =
				math.deg(
					math.atan2(
						delta.Y,
						delta.X
					)
				)
		else

			AimLine.Visible =
				false
		end

		local desired =
			CFrame.lookAt(
				Camera.CFrame.Position,
				head.Position
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				desired,
				math.clamp(
					Settings.AimSmooth,
					0.01,
					1
				)
			)
	end
)

