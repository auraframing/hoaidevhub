local ESPObjects = {}

local function RemoveESP(player)
	local object = ESPObjects[player]

	if object then
		object:Destroy()
		ESPObjects[player] = nil
	end
end

local function GetTeamColor(player)
	if player.Team then
		return player.TeamColor.Color
	end

	return Colors.AccentLight
end

local function AddESP(player)
