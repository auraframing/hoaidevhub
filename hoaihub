--========================================================

local NoClipOriginal = setmetatable({}, { __mode = "k" })

local function ApplyNoClipToPart(Part)
    if not Part:IsA("BasePart") then
        return
    end

    if NoClipOriginal[Part] == nil then
        NoClipOriginal[Part] = Part.CanCollide
    end

    Part.CanCollide = not Config.NoClipEnabled and NoClipOriginal[Part] or false
end

local function RefreshNoClip()
    local Character = GetCharacter()
    if not Character then
        return
    end

    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA("BasePart") then
            ApplyNoClipToPart(Object)
        end
    end
end

local function ClearNoClipCache()
    local Character = GetCharacter()
    if Character then
        for _, Object in ipairs(Character:GetDescendants()) do
            if Object:IsA("BasePart") and NoClipOriginal[Object] ~= nil then
                Object.CanCollide = NoClipOriginal[Object]
            end
        end
    end
end

local function SetNoClip(State)
    Config.NoClipEnabled = State

    if State then
        RefreshNoClip()
    else
        ClearNoClipCache()
    end
end

-- Character parts are handled only when they are added or when the toggle changes.
local function HookNoClipCharacter(Character)
    Character.DescendantAdded:Connect(function(Object)
        if Config.NoClipEnabled and Object:IsA("BasePart") then
            task.defer(function()
                if Object.Parent then
                    ApplyNoClipToPart(Object)
                end
            end)
        end
    end)

    task.defer(function()
        if Character.Parent and Config.NoClipEnabled then
            RefreshNoClip()
        end
    end)
end

if LocalPlayer.Character then
    HookNoClipCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(Character)
    NoClipOriginal = setmetatable({}, { __mode = "k" })
    HookNoClipCharacter(Character)
end)

