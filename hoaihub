--==================================================

LP.CharacterAdded:Connect(
	function(character)

		task.wait(0.4)

		ClearFakeLagBuffer()
		FakeLagClock = 0

		table.clear(
			SavedCollision
		)

		StopFly()

		FlyUp = false
		FlyDown = false

		BindMovement(
			character
		)

		if Settings.NoClip then
			SetNoClip(true)
		end

		if Settings.FPSBoost then
			DisableVisualEffects(character)
		end

		if Settings.FlyEnabled then

			StartFly()

			FlyControlFrame.Visible =
				true
		else

			FlyControlFrame.Visible =
				false
		end

		if Settings.ESP then
			RefreshESP()
		end
	end
)

if LP.Character then
	BindMovement(
		LP.Character
	)
end

--==================================================
-- KEYBOARD FLY
--==================================================

UIS.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if not Settings.FlyEnabled then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.Space then

			FlyUp = true

		elseif input.KeyCode ==
			Enum.KeyCode.LeftControl then

			FlyDown = true
		end
	end
)

UIS.InputEnded:Connect(
	function(input)

		if input.KeyCode ==
			Enum.KeyCode.Space then

			FlyUp = false

		elseif input.KeyCode ==
			Enum.KeyCode.LeftControl then

			FlyDown = false
		end
	end
)

