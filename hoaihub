local SavedCollision = {}

local function SetNoClip(state)
	local character = LP.Character

	if not character then
		return
	end

	if state then
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BasePart") then
				if SavedCollision[object] == nil then
					SavedCollision[object] = object.CanCollide
				end

				object.CanCollide = false
			end
		end
	else
		for object, oldState in pairs(SavedCollision) do
			if object and object.Parent then
				object.CanCollide = oldState
			end
		end

		table.clear(SavedCollision)
	end
end

--==================================================
-- MOVEMENT
--==================================================

local MovementConnection
local JumpConnection

local function ApplyMovement()
	local character = LP.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	humanoid.UseJumpPower = true

	if not Settings.FlyEnabled then
		humanoid.WalkSpeed =
			Settings.SpeedEnabled and Settings.Speed or 16
	end

	humanoid.JumpPower =
		Settings.JumpEnabled and Settings.Jump or 50
end

local function BindMovement(character)
	if MovementConnection then
		MovementConnection:Disconnect()
		MovementConnection = nil
	end

	if JumpConnection then
		JumpConnection:Disconnect()
		JumpConnection = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	ApplyMovement()

	MovementConnection =
		humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if Settings.SpeedEnabled and not Settings.FlyEnabled
				and humanoid.WalkSpeed ~= Settings.Speed then

				humanoid.WalkSpeed = Settings.Speed
			end
		end)

	JumpConnection =
		humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
			if Settings.JumpEnabled
				and humanoid.JumpPower ~= Settings.Jump then

				humanoid.JumpPower = Settings.Jump
			end
		end)
end

