local function RefreshESP()
	for player in pairs(ESPObjects) do
		RemoveESP(player)
	end

	if not Settings.ESP then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then
			AddESP(player)
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.4)

		if Settings.ESP then
			AddESP(player)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	RemoveESP(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LP then
		player.CharacterAdded:Connect(function()
			task.wait(0.4)

			if Settings.ESP then
				AddESP(player)
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	if not Settings.ESP then
		return
	end

	local localCharacter = LP.Character
	local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

	for player, folder in pairs(ESPObjects) do
		if not folder.Parent or not player.Parent then
			RemoveESP(player)
			continue
		end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local billboard = folder:FindFirstChild("Info")

		if not character or not humanoid or not root or not billboard then
			continue
		end

		local nameLabel = billboard:FindFirstChild("NameLabel")
		local distanceLabel = billboard:FindFirstChild("DistanceLabel")
		local hpBack = billboard:FindFirstChild("HPBack")

		if localRoot and distanceLabel then
			local distance = (localRoot.Position - root.Position).Magnitude
			distanceLabel.Text = math.floor(distance + 0.5) .. " studs"
		end

		if hpBack then
			local hpFill = hpBack:FindFirstChild("HPFill")

			if hpFill then
				local percent = math.clamp(
					humanoid.Health / math.max(humanoid.MaxHealth, 1),
					0,
					1
				)

				hpFill.Size = UDim2.new(percent, 0, 1, 0)

				if percent > 0.6 then
					hpFill.BackgroundColor3 = Colors.Success
				elseif percent > 0.3 then
					hpFill.BackgroundColor3 = Color3.fromRGB(255, 190, 70)
				else
					hpFill.BackgroundColor3 = Colors.Danger
				end
			end
		end

		local color = GetTeamColor(player)
		local highlight = folder:FindFirstChild("Highlight")

		if highlight then
			highlight.FillColor = color
			highlight.OutlineColor = color
		end

		if nameLabel then
			nameLabel.TextColor3 = color
		end
	end
end)

