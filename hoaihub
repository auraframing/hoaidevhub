local function DisableVisualEffects(root)

	for _, object in ipairs(
		root:GetDescendants()
	) do

		if object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Beam")
			or object:IsA("Smoke")
			or object:IsA("Fire") then

			object.Enabled =
				false

		elseif object:IsA("BasePart") then

			object.CastShadow =
				false
		end
	end
end

local FPSSavedParts = {}
local FPSSavedEffects = {}
local FPSSavedLighting = nil

local function SaveAndDisableObject(object)
	if object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("Smoke")
		or object:IsA("Fire") then

		if FPSSavedParts[object] == nil then
			FPSSavedParts[object] = object.Enabled
		end

		object.Enabled = false

	elseif object:IsA("BasePart") then

		if FPSSavedParts[object] == nil then
			FPSSavedParts[object] = object.CastShadow
		end

		object.CastShadow = false
	end
end

local function DisableVisualEffects(root)
	for _, object in ipairs(root:GetDescendants()) do
		SaveAndDisableObject(object)
	end
end

local function ApplyFPSBoost(state)
	Settings.FPSBoost = state

	if state then
		pcall(function()
			if FPSSavedLighting == nil then
				FPSSavedLighting = {
					GlobalShadows = Lighting.GlobalShadows,
					EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
					EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
				}
			end

			Lighting.GlobalShadows = false
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
		end)

		for _, object in ipairs(Lighting:GetChildren()) do
			if object:IsA("PostEffect") then
				if FPSSavedEffects[object] == nil then
					FPSSavedEffects[object] = object.Enabled
				end
				object.Enabled = false
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				DisableVisualEffects(player.Character)
			end
		end
	else
		for object, oldState in pairs(FPSSavedParts) do
			if object and object.Parent then
				if object:IsA("BasePart") then
					object.CastShadow = oldState
				elseif object:IsA("ParticleEmitter")
					or object:IsA("Trail")
					or object:IsA("Beam")
					or object:IsA("Smoke")
					or object:IsA("Fire") then
					object.Enabled = oldState
				end
			end
		end
		table.clear(FPSSavedParts)

		for object, oldState in pairs(FPSSavedEffects) do
			if object and object.Parent then
				object.Enabled = oldState
			end
		end
		table.clear(FPSSavedEffects)

		if FPSSavedLighting then
			pcall(function()
				Lighting.GlobalShadows = FPSSavedLighting.GlobalShadows
				Lighting.EnvironmentDiffuseScale = FPSSavedLighting.EnvironmentDiffuseScale
				Lighting.EnvironmentSpecularScale = FPSSavedLighting.EnvironmentSpecularScale
			end)
			FPSSavedLighting = nil
		end
	end
	SaveAndDisableObject(object)
end)

