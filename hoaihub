--========================================================
-- PLAYER EVENTS
--========================================================

Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function()
        task.wait(0.5)

        if Config.ESPEnabled then
            CreateESP(Player)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(Player)
    RemoveESP(Player)
    TargetCache[Player] = nil

    if CurrentTarget == Player then
        CurrentTarget = nil
    end
end)

for _, Player in ipairs(Players:GetPlayers()) do
    if Player ~= LocalPlayer then
        Player.CharacterAdded:Connect(function()
            task.wait(0.5)

            if Config.ESPEnabled then
                CreateESP(Player)
            end
        end)

        if Player.Character and Config.ESPEnabled then
            CreateESP(Player)
        end
    end
end

--========================================================
-- FIX LAG LOOP
--========================================================

-- Chạy Fix Lag theo chu kỳ riêng để không quét workspace
-- ở mỗi frame RenderStepped.
task.spawn(function()
    while true do
        task.wait(1)

        if Config.FixLag then
            ApplyFixLag()
        end
    end
end)

workspace.DescendantAdded:Connect(function(Object)
    if not Config.FixLag then
        return
    end

    local Model = Object:IsA("Model") and Object or Object:FindFirstAncestorOfClass("Model")
    if not Model or Model:FindFirstChildOfClass("Humanoid") then
        return
    end

    task.defer(function()
        if Config.FixLag and Model.Parent then
            if not HiddenObjects[Model] then
                HiddenObjects[Model] = true
                for _, Part in ipairs(Model:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.LocalTransparencyModifier = 1
                    elseif Part:IsA("ParticleEmitter") or Part:IsA("Trail") or Part:IsA("Beam")
                        or Part:IsA("Smoke") or Part:IsA("Fire") or Part:IsA("Sparkles") then
                        Part.Enabled = false
                    end
                end
            end
        end
    end)
end)

--========================================================
-- ESP UPDATE LOOP
--========================================================

local ESP_UPDATE_INTERVAL = 0.10

task.spawn(function()
    while true do
        task.wait(ESP_UPDATE_INTERVAL)

        if Config.ESPEnabled then
            local MyRoot = GetRoot(GetCharacter())

            for Player, Data in pairs(ESP) do
                local PlayerCharacter = Player.Character
                local PlayerHumanoid = PlayerCharacter and PlayerCharacter:FindFirstChildOfClass("Humanoid")
                local PlayerRoot = GetRoot(PlayerCharacter)

                if PlayerHumanoid and PlayerRoot and MyRoot then
                    Data.Gui.Enabled = true
                    Data.Health.Text =
                        "HP: " .. math.floor(PlayerHumanoid.Health) ..
                        " / " .. math.floor(PlayerHumanoid.MaxHealth)

                    local Distance = (PlayerRoot.Position - MyRoot.Position).Magnitude
                    Data.Distance.Text =
                        "Distance: " .. math.floor(Distance) .. " studs"
                else
                    Data.Gui.Enabled = false
                end
            end
        end
    end
end)

--========================================================
-- CAMERA AIM
--========================================================

RunService:BindToRenderStep(
    "HoaiHub_Aim",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not Config.TargetEnabled then
            return
        end

        local Target = CurrentTarget
        if not Target or not TargetCache[Target] then
            return
        end

        local TargetCharacter = Target.Character
        local TargetRoot = GetRoot(TargetCharacter)
        if not TargetRoot then
            return
        end

        local Desired = CFrame.lookAt(
            Camera.CFrame.Position,
            TargetRoot.Position
        )

        Camera.CFrame = Camera.CFrame:Lerp(
            Desired,
            math.clamp(Config.TargetSmooth, 0.01, 1)
        )
    end
)

--========================================================
-- MAIN LOOP
--========================================================

RunService.RenderStepped:Connect(function()
    local Character = GetCharacter()
    local Humanoid = GetHumanoid()
    local Root = GetRoot(Character)

    -- SPEED
    if Humanoid and Config.SpeedEnabled then
        if Humanoid.WalkSpeed ~= Config.SpeedValue then
            Humanoid.WalkSpeed = Config.SpeedValue
        end
    end

    -- JUMP
    if Humanoid and Config.JumpEnabled then
        if not Humanoid.UseJumpPower then
            Humanoid.UseJumpPower = true
        end
        if Humanoid.JumpPower ~= Config.JumpValue then
            Humanoid.JumpPower = Config.JumpValue
        end
    end

    -- MOBILE FLY UI
    MobileControls.Visible = Config.FlyEnabled

    -- FLY
    if Config.FlyEnabled and Root then
        local MoveDirection = Vector3.zero

        if Humanoid then
            MoveDirection = Humanoid.MoveDirection
        end

        local Vertical = 0

        if FlyUp then
            Vertical += 1
        end

        if FlyDown then
            Vertical -= 1
        end

        Root.AssemblyLinearVelocity =
            (MoveDirection * Config.FlySpeed)
            + Vector3.new(
                0,
                Vertical * Config.FlySpeed,
                0
            )
    else
        FlyUp = false
        FlyDown = false
    end

    -- TARGET UI / selection timer
    if Config.TargetEnabled then
        POVCircle.Visible = true
        POVCircle.Size = UDim2.fromOffset(
            Config.POVRange * 2,
            Config.POVRange * 2
        )

        local Now = os.clock()
        if Now - TargetSelectionTick >= TargetSelectionInterval then
            TargetSelectionTick = Now
            CurrentTarget = GetNearestTarget()
        end

        if CurrentTarget and not IsTargetStillUsable(CurrentTarget) then
            CurrentTarget = nil
        end
    else
        CurrentTarget = nil
        POVCircle.Visible = false
    end

end)

