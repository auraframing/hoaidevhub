local HiddenObjects = {}

local function ApplyFixLag()
    if not Config.FixLag then
        return
    end

    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object:IsA("Model") then
            local Humanoid = Object:FindFirstChildOfClass("Humanoid")

            if not Humanoid and not Object:IsDescendantOf(Camera) then
                if not HiddenObjects[Object] then
                    HiddenObjects[Object] = true

                    for _, Part in ipairs(Object:GetDescendants()) do
                        if Part:IsA("BasePart") then
                            Part.LocalTransparencyModifier = 1
                        elseif Part:IsA("ParticleEmitter")
                            or Part:IsA("Trail")
                            or Part:IsA("Beam")
                            or Part:IsA("Smoke")
                            or Part:IsA("Fire")
                            or Part:IsA("Sparkles") then
                            Part.Enabled = false
                        end
                    end
                end
            end
        end
    end
end

