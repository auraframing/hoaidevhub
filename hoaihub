local function UpdateESP()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            if Config.ESPEnabled then
                if not ESP[Player] and Player.Character then
                    CreateESP(Player)
                end
            else
                RemoveESP(Player)
            end
        end
    end
end

