local function AddToggle(Page, Text, Initial, Callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -8, 0, 40)
    Button.BackgroundColor3 = Color3.fromRGB(40, 21, 52)
    Button.TextColor3 = Color3.fromRGB(240, 220, 250)
    Button.TextSize = 13
    Button.Font = Enum.Font.GothamMedium
    Button.Parent = Page

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 9)
    Corner.Parent = Button

    local State = Initial

    local function Refresh()
        Button.Text = Text .. ": " .. (State and "ON" or "OFF")

        Button.BackgroundColor3 = State
            and Color3.fromRGB(100, 48, 130)
            or Color3.fromRGB(40, 21, 52)
    end

    Button.MouseButton1Click:Connect(function()
        State = not State
        Refresh()
        Callback(State)
    end)

    Refresh()
    return Button
end

